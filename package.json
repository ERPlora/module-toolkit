{
  "name": "@erplora/module-toolkit",
  "version": "0.1.0",
  "type": "module",
  "description": "ERPlora module toolkit (Ionic-style CLI): scaffolding (startproject + g module), dev preview, validation and standalone build to dist/<id>.esm.js. The toolkit is the wrapper that provides the dependencies (lit + @erplora/outfitkit + @erplora/module-sdk + tsconfig), so the module repository stays clean.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ERPlora/module-toolkit.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "erplora": "bin/erplora.mjs"
  },
  "exports": {
    "./money-display-guard": {
      "types": "./src/money-display-guard.d.mts",
      "default": "./src/money-display-guard.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "contracts",
    "vendor",
    "!vendor/**/*.tmp"
  ],
  "scripts": {
    "test": "node --test",
    "prepack": "node scripts/bundle-hub-sdk.mjs",
    "sync-mirrors": "node scripts/sync-hub-mirrors.mjs",
    "sync-schema": "npm run --silent sync-mirrors",
    "hub-outfitkit-rows": "node scripts/hub-outfitkit-rows.mjs",
    "smoke": "node bin/erplora.mjs build ../modules-workspace/modules/inventory && node bin/erplora.mjs build ../modules-workspace/modules/sales"
  },
  "dependencies": {
    "@erplora/outfitkit": "^0.1.98",
    "@iconify-json/ion": "^1.2.7",
    "@iconify/utils": "^3.1.3",
    "@ionic/core": "^8.8.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.24.0",
    "lit": "^3.2.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@erplora/module-sdk": "file:../hub/packages/module-sdk",
    "@erplora/module-types": "file:../hub/packages/module-types",
    "@erplora/outfitkit": "file:../outfitkit"
  }
}
