      ]
    },
    "tables._session_merge": {
      "permission": "tables.transfer_tablesession",
      "sql": [
        "commands/_session_merge_close.sql",
        "commands/_assignment_release_merged.sql",
        "commands/_session_merge_free.sql",
        "commands/_session_merge_adopt_order.sql",
        "commands/_session_merge_detach_order.sql",
        "commands/_session_merge_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._session_split": {
      "permission": "tables.change_tablesession",
      "transaction": true,
      "sql": [
        "commands/_session_split_insert.sql",
        "commands/_assignment_split_open.sql",
        "commands/_session_split_occupy.sql",
        "commands/_hold_consume_seated.sql",
        "commands/_session_split_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._session_delete": {
      "permission": "tables.delete_tablesession",
      "sql": [
        "commands/_session_delete_update.sql",
        "commands/_session_delete_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._zone_delete": {
      "permission": "tables.delete_zone",
      "sql": [
        "commands/_zone_delete_update.sql",
        "commands/_zone_delete_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables._table_delete": {
      "permission": "tables.delete_table",
      "sql": [
        "commands/_table_delete_update.sql",
        "commands/_table_delete_assert.sql",
        "commands/_gate_clear.sql"
      ]
    },
    "tables.sessions.link_order": {
      "permission": "tables.add_tablesession",
      "transaction": true,
      "sql": [
        "commands/session_link_order.sql"
      ],
      "ai": {
        "description": "Links the active session of a table to an open order (ADR-0141 table-order junction). Called by the POS when it opens an order while a table is selected."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "tables.session_not_active",
        "message": "That check is not open: it does not exist in this business, or it has already been closed, transferred, merged or parked."
      }
    },
    "tables.sessions.set_guests": {
      "permission": "tables.change_tablesession",
      "transaction": true,
      "schema": "schemas/session_set_guests.json",
      "sql": [
        "commands/session_set_guests.sql"
      ],
      "emit": [
        "tables.session.updated"
      ],
      "ai": {
        "description": "Corrects the number of covers (guests) of an open table session, e.g. when an extra guest joins. Only active sessions are updated."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "tables.session_not_active",
        "message": "That check is not open: it does not exist in this business, or it has already been closed, transferred, merged or parked."
      }
    },
    "tables._session_close_by_order": {
      "permission": "tables.change_tablesession",
      "transaction": true,
      "sql": [
        "commands/_session_close_by_order.sql",
        "commands/_assignment_release_by_order.sql",
        "commands/_table_free_by_order.sql"
      ],
      "ai": {
        "description": "Internal: closes the table session (and its history segment) when its order ends — paid or voided (ADR-0146). Listener target, not called directly."
      }
    },
    "tables.sessions.park": {
      "permission": "tables.change_tablesession",
      "transaction": true,
      "sql": [
        "commands/_assignment_release_parked.sql",
        "commands/_table_free_by_session.sql",
        "commands/_session_park.sql"
      ],
      "schema": "schemas/session_park.json",
      "emit": [
        "tables.session.parked"
      ],
      "ai": {
        "description": "Parks an open check: releases the table WITHOUT closing the account (ADR-0146). The session stays alive (guests, waiter, start time) and its history segment closes with reason `parked`; parking never opens a new segment, because a parked check is not sitting at any table."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "tables.session_not_active",
        "message": "That check is not open: it does not exist in this business, or it has already been closed, transferred, merged or parked."
      }
    },
    "tables.sessions.restore": {
      "permission": "tables.change_tablesession",
      "transaction": true,
      "sql": [
        "commands/_session_restore.sql",
        "commands/_assignment_restore.sql",
        "commands/_table_occupy_by_session.sql",
        "commands/_hold_consume_seated.sql"
      ],
      "schema": "schemas/session_restore.json",
      "emit": [
        "tables.session.restored"
      ],
      "ai": {
        "description": "Seats a parked check at a table again (the same one or another) — ADR-0146. Opens a new history segment with reason `restored`."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "tables.session_not_parked",
        "message": "That check is not parked: it does not exist in this business, or it is already seated at a table."
      }
    },
    "tables._hold_from_reservation": {
      "permission": "tables.change_tablesession",
      "transaction": true,
      "sql": [
        "commands/_hold_from_reservation_upsert.sql",
        "commands/_hold_paint_reservation.sql",
        "commands/_hold_from_reservation_release.sql",
        "commands/_hold_free_stale.sql"
      ]
    },
    "tables._hold_move_from_reservation": {
      "permission": "tables.change_tablesession",
      "transaction": true,
      "sql": [
        "commands/_hold_move_from_reservation.sql",
        "commands/_hold_paint_reservation.sql",
        "commands/_hold_free_stale.sql"
      ]
    },
    "tables.settings.update": {
      "permission": "tables.manage_settings",
      "transaction": true,
      "schema": "schemas/settings_update.json",
      "sql": [
        "commands/settings_update.sql"
      ],
      "emit": [
        "tables.settings.updated"
      ],
      "ai": {
        "description": "Updates the room settings (guests prompt on seating, amber/red timer thresholds)"
      }
    }
  },
  "errors": {
    "tables.hold_not_found": {},
    "tables.session_not_active": {},
    "tables.session_not_parked": {},
    "tables.table_has_active_session": {},
    "tables.table_not_available": {},
    "tables.table_not_found": {},
    "tables.zone_has_tables": {},
    "tables.zone_not_found": {},
    "tables.zone_unavailable": {}
  },
  "ui": {
    "entry": "dist/tables.esm.js"
  },
  "events": {
    "listen": {
      "order.completed": {
        "command": "tables._session_close_by_order"
      },
      "sale.voided": {
        "command": "tables._session_close_by_order"
      },
      "reservations.reservation.status_changed": {
        "command": "tables._hold_from_reservation"
      },
      "reservations.reservation.updated": {
        "command": "tables._hold_move_from_reservation"
      }
    },
    "emits": [
      "tables.session.closed",
      "tables.session.deleted",
      "tables.session.merged",
      "tables.session.opened",
      "tables.session.parked",
      "tables.session.restored",
      "tables.session.split",
      "tables.session.transferred",
      "tables.session.updated",
      "tables.table.created",
      "tables.table.deleted",
      "tables.table.held",
      "tables.table.hold_released",
      "tables.table.updated",
      "tables.zone.created",
      "tables.zone.deleted",
      "tables.zone.updated",
      "tables.settings.updated"
    ]
  },
  "scheduled_tasks": [
    {
      "name": "expire_table_holds",
      "command": "tables.tables.expire_holds",
      "cron": "*/15 * * * *",
      "catch_up": "collapse"
    }
  ],
  "setup": {
    "query": "tables.floor.status",
    "configured_when": [
      {
        "field": "usable_tables",
        "truthy": true
      }
    ],
    "title": "Your tables",
    "description": "Add the tables of your dining room: without them there is no order per table, no split and no transfer.",
    "icon": "map-outline",
    "route": "/m/tables/tables",
    "permission": "tables.add_table",
    "countries": [],
    "order": 100,
    "required": false
  }
}
